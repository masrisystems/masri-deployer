name: Deploy Staging Application

on:
  push:
    branches:
      - {{STAGING_BRANCH}}
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.4'
          extensions: dom, curl, libxml, mbstring, zip, pcntl, pdo, sqlite, pdo_sqlite, bcmath, soap, intl, readline, ldap, msgpack, igbinary, redis, swoole, memcached, pcov, xdebug
          coverage: none

      - name: Get Composer Cache Directory
        id: composer-cache
        run: echo "dir=$(composer config cache-files-dir)" >> $GITHUB_OUTPUT

      - name: Cache Composer Dependencies
        uses: actions/cache@v4
        with:
          path: ${{ steps.composer-cache.outputs.dir }}
          key: ${{ runner.os }}-composer-${{ hashFiles('**/composer.lock') }}
          restore-keys: ${{ runner.os }}-composer-

      - name: Install Composer Dependencies
        run: composer install --no-interaction --prefer-dist --optimize-autoloader

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Cache NPM Dependencies
        uses: actions/cache@v4
        with:
          path: ~/.npm
          key: ${{ runner.os }}-node-${{ hashFiles('**/package-lock.json') }}
          restore-keys: ${{ runner.os }}-node-

      - name: Install NPM Dependencies
        run: npm ci

      - name: Prepare Environment
        run: |
          cp .env.example .env
          php artisan key:generate

          # Add frontend secrets needed for the build
          echo "VITE_APP_NAME=\"{{VITE_APP_NAME}}\"" >> .env
          echo "VITE_GOOGLE_MAPS_API_KEY=\"${{ secrets.VITE_GOOGLE_MAPS_API_KEY }}\"" >> .env

          # Setup SQLite database for tests
          touch database/database.sqlite
          sed -i 's/DB_CONNECTION=.*/DB_CONNECTION=sqlite/' .env
          echo "DB_DATABASE=$(pwd)/database/database.sqlite" >> .env

      - name: Build Assets (Full SSR Build)
        run: |
          npm run build:ssr
          npm run docs:build || true
        env:
          NODE_OPTIONS: '--max-old-space-size=4096'

      - name: Run Pre-Deploy Checks
        run: composer pre-deploy

      - name: Sync Translations
        run: php artisan translate:sync --all || true

      - name: Setup SSH
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.{{STAGING_SSH_KEY_SECRET}} }}

      - name: Add Server to Known Hosts
        run: |
          mkdir -p ~/.ssh
          echo -e "Host *\n\tStrictHostKeyChecking no\n\tUserKnownHostsFile /dev/null" > ~/.ssh/config
          chmod 600 ~/.ssh/config

      - name: Remote Backup & Maintenance Mode
        run: |
          ssh {{STAGING_USER}}@{{STAGING_HOST}} << 'EOF'
            set +e
            REMOTE_APP_PATH="{{STAGING_APP_PATH}}"
            echo "📂 CD into: $REMOTE_APP_PATH"
            cd $REMOTE_APP_PATH || exit 1

            echo "🧹 Cleaning old backup..."
            rm -rf public/build_backup

            echo "💾 Attempting backup..."
            if [ -d "public/build" ]; then
                cp -r public/build public/build_backup
            fi

            echo "🛑 Activating Maintenance Mode..."
            php artisan down --render="errors::503" || true

            # Prepare folders for new assets
            mkdir -p public/build
            mkdir -p bootstrap/ssr
          EOF

      - name: Upload Build Assets
        run: |
          rsync -az --delete public/build/ {{STAGING_USER}}@{{STAGING_HOST}}:{{STAGING_APP_PATH}}/public/build/
          rsync -az --delete bootstrap/ssr/ {{STAGING_USER}}@{{STAGING_HOST}}:{{STAGING_APP_PATH}}/bootstrap/ssr/

      - name: Execute Remote Deploy Script & Restart SSR
        run: |
          ssh {{STAGING_USER}}@{{STAGING_HOST}} << 'EOF'
            export PATH=$HOME/bin:$PATH
            cd {{STAGING_APP_PATH}}
            
            # Pull latest code and install PHP dependencies
            git pull origin {{STAGING_BRANCH}}
            composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev
            
            # Clear and rebuild cache
            php artisan optimize:clear
            php artisan migrate --force
            php artisan optimize
            
            # Restart SSR process
            supervisorctl restart {{SSR_PROCESS}} || true
            
            # Cleanup backup on success
            rm -rf {{STAGING_APP_PATH}}/public/build_backup

            # Bring application out of maintenance mode
            cd {{STAGING_APP_PATH}} && php artisan up
          EOF

      - name: Rollback on Failure
        if: failure()
        run: |
          ssh {{STAGING_USER}}@{{STAGING_HOST}} << 'EOF'
            REMOTE_APP_PATH="{{STAGING_APP_PATH}}"
            if [ -d "${REMOTE_APP_PATH}/public/build_backup" ]; then
                echo "❌ DEPLOYMENT FAILED! Initiating Rollback..."
                rm -rf "${REMOTE_APP_PATH}/public/build"
                mv "${REMOTE_APP_PATH}/public/build_backup" "${REMOTE_APP_PATH}/public/build"
            fi
            cd ${REMOTE_APP_PATH} && php artisan up
          EOF
